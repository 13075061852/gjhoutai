# /etc/gjhoutai/ai.env —— 权限 640，属主 root:gjhoutai
# 密钥只存在于本文件（不会下发到浏览器，也不写进 models.json）

AI_HOST=127.0.0.1
AI_PORT=8790
APP_BASE_PATH=/gjhoutai
DATA_DIR=/var/lib/gjhoutai/data
AI_AGENT_DIR=/var/lib/gjhoutai/pi

# 模型：provider:model。配置 AI_BASE_URL 时走「OpenAI 兼容端点」，
# 服务会在 agent 目录生成 models.json，apiKey 用环境变量插值。
AI_PROVIDER_ID=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek:deepseek-chat
AI_THINKING_LEVEL=off

# 模型支持的输入模态（逗号分隔）；当前端点 deepseek-chat 走 deepseek-flash，支持图片输入。
# 换成纯文本模型时改成 text，否则内核不会把图片交给模型。
AI_MODEL_INPUT=text,image

# 密钥（两行都填同一个值即可；内置 provider 读 DEEPSEEK_API_KEY）
AI_API_KEY=replace-me
DEEPSEEK_API_KEY=replace-me

# 并发与超时
AI_MAX_CONCURRENT_RUNS=4
AI_MAX_RUNS_PER_USER=2
AI_RUN_TIMEOUT_MS=300000
AI_RUN_TTL_MS=1800000
AI_MAX_PROMPT_CHARS=8000
AI_SSE_HEARTBEAT_MS=15000

# 附件：目录必须在 systemd ReadWritePaths 允许的路径内（默认 <AI_AGENT_DIR>/uploads）。
AI_UPLOAD_DIR=/var/lib/gjhoutai/pi/uploads
AI_MAX_ATTACHMENTS=4
AI_ATTACHMENT_TTL_MS=86400000
