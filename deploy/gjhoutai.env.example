# Copy to /etc/gjhoutai/gjhoutai.env and replace every change-me value.
# chmod 600 and chown root:gjhoutai
PORT=8788
HOST=127.0.0.1
DATA_DIR=/var/lib/gjhoutai/data
DIST_DIR=/var/www/gjhoutai/app/dist
APP_BASE_PATH=/gjhoutai
CORS_ORIGINS=https://www.kingpolymer.com,https://kingpolymer.com,http://127.0.0.1:5001,http://localhost:5001
CONFIG_ENCRYPTION_KEY=change-me
BOOTSTRAP_ADMIN_TOKEN=change-me
