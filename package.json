{
  "name": "gjhoutai-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run check:legacy-types && tsc -b && vite build",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name gjhoutai-web",
    "deploy:api": "wrangler deploy",
    "deploy:db": "wrangler d1 migrations apply gjhoutai --remote",
    "preview": "vite preview",
    "check:lockfile": "node scripts/check-package-lock.mjs",
    "typecheck": "npm run check:legacy-types && tsc -b --noEmit",
    "test": "vitest run",
    "check-icons": "node scripts/check-icon-mappings.mjs",
    "check:ui": "node scripts/check-ui-consistency.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:legacy-types": "node scripts/check-legacy-ts-nocheck.mjs",
    "update:siliconflow-catalog": "node scripts/update-siliconflow-catalog.mjs"
  },
  "dependencies": {
    "@icon-park/svg": "1.4.2",
    "markdown-it": "14.2.0",
    "motion": "12.38.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/markdown-it": "14.1.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "lightningcss": "1.32.0",
    "sharp": "0.35.2",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.5",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "ws": "8.20.1"
  }
}
