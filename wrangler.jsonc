{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gjhoutai-storage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORS_ORIGINS": "http://127.0.0.1:5001,http://localhost:5001,https://jobos.top,https://www.jobos.top,https://gjhoutai.pages.dev,https://harvest.apib.ai,https://21su.com,https://www.21su.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gjhoutai",
      "database_id": "bbe30b6f-234d-40ec-989c-4628c20e1280"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gjhoutai-files"
    }
  ]
}
